# ══════════════════════════════════════════════════════════════
# RS Pipeline — Environment Configuration
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── Mill selection (required) ──────────────────────────────────
# One of: EMSA | IPSA | MONTE_ROSA | PANTALEON | AMAJAC
MILL=EMSA

# ── Date configuration (required) ─────────────────────────────
# Satellite image search window
FECHA_INICIO=2026-03-24
FECHA_FIN=2026-03-27

# Processing dates for zonal statistics (comma-separated)
FECHAS=2026-03-26

# ── S3 workspace (optional — defaults shown) ───────────────────
S3_BUCKET=carrier-pdfs
S3_PREFIX=rs-pipeline-sync

# ── Microsoft Teams notifications (optional) ──────────────────
# Create an Incoming Webhook in Teams: channel → Connectors → Incoming Webhook
# Leave blank to disable notifications
TEAMS_WEBHOOK_URL=

# ── AWS credentials ────────────────────────────────────────────
# Leave blank on ECS (uses IAM task role automatically).
# Required when running locally or on GCP.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
