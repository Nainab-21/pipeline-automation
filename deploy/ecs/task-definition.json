{
  "family": "rs-pipeline",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "4096",
  "memory": "16384",

  "taskRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/rs-pipeline-task-role",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/rs-pipeline-execution-role",

  "containerDefinitions": [
    {
      "name": "rs-pipeline",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.YOUR_REGION.amazonaws.com/rs-pipeline:latest",
      "essential": true,

      "environment": [
        { "name": "S3_BUCKET", "value": "carrier-pdfs" },
        { "name": "S3_PREFIX", "value": "rs-pipeline-sync" }
      ],

      "secrets": [],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rs-pipeline",
          "awslogs-region": "YOUR_REGION",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },

      "stopTimeout": 120
    }
  ]
}
