{
  "Comment": "Attach this policy to the ECS task role (rs-pipeline-task-role). It grants the container access to the S3 workspace bucket.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3WorkspaceAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::carrier-pdfs",
        "arn:aws:s3:::carrier-pdfs/rs-pipeline-sync/*"
      ]
    },
    {
      "Sid": "ECRPull",
      "Effect": "Allow",
      "Action": [
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/ecs/rs-pipeline*"
    }
  ]
}
